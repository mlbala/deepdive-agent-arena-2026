# =============================================================================
# DeepDive — environment configuration (copy to .env; never commit .env)
# =============================================================================

# --- Mesh API gateway (MANDATORY: every LLM + embedding call routes here) ---
MESH_API_KEY=rsk_your_mesh_api_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1

# Default chat model for all agents (Mesh uses provider/model identifiers)
MESH_DEFAULT_MODEL=openai/gpt-4o-mini
# Optional per-agent overrides (leave empty to inherit MESH_DEFAULT_MODEL)
PLANNER_MODEL=
RESEARCHER_MODEL=
DRAFTER_MODEL=
VERIFIER_MODEL=
SYNTHESIZER_MODEL=
FOLLOWUP_MODEL=
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

# Gateway resilience
MESH_TIMEOUT_SECONDS=60
MESH_MAX_RETRIES=4
MESH_JSON_REPAIR_ATTEMPTS=2
MESH_JSON_MODE=true

# --- Web retrieval (Tier 1 Tavily -> Tier 2 DuckDuckGo -> Tier 3 offline corpus) ---
# Optional: without a Tavily key DeepDive falls back to DuckDuckGo + BeautifulSoup.
TAVILY_API_KEY=
# auto | tavily | ddg | offline
SEARCH_MODE=auto
SEARCH_MAX_RESULTS=5

# --- Evidence index ---
# hybrid (ChromaDB dense via Mesh embeddings + TF-IDF sparse) | tfidf
VECTOR_BACKEND=hybrid
# Leave empty for an ephemeral in-memory ChromaDB; set a path to persist
CHROMA_PERSIST_DIR=

# --- Self-verification loop ---
MAX_ITERATIONS=3
COVERAGE_THRESHOLD=0.70
GROUNDING_THRESHOLD=0.75
# SUPPORTED verdicts resting solely on sources below this authority are downgraded
MIN_SOURCE_AUTHORITY=0.45

# --- Storage ---
DATABASE_URL=sqlite:///./data/deepdive.db
# Purge runs older than N days at startup (0 = keep forever)
DATA_RETENTION_DAYS=0

# --- Guardrails ---
GUARDRAILS_ENABLED=true
GUARDRAIL_LLM_SCREEN=true
BLOCK_PROMPT_INJECTION=true
REDACT_PII_IN_QUERIES=true
REDACT_PII_IN_DOCUMENTS=true
REDACT_PII_IN_OUTPUT=true
# Comma-separated domains that are never fetched or indexed
BLOCKED_DOMAINS=

# --- Governance ---
# Comma-separated Mesh model allowlist (empty = only the models configured above)
ALLOWED_MODELS=
MAX_LLM_CALLS_PER_RUN=150
MAX_TOKENS_PER_RUN=2000000
BUDGET_SOFT_FRACTION=0.75

# --- API security ---
# Comma-separated API keys; when set, every /api route except /api/health requires X-API-Key
API_KEYS=
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_RESEARCH_PER_MINUTE=10
RATE_LIMIT_FOLLOWUP_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
MAX_CONCURRENT_RUNS=4

# --- Server ---
ENVIRONMENT=development
LOG_LEVEL=INFO
